# ==============================================================================
# AgenticSOC Environment Configuration Template
# ==============================================================================

# LLM Engine Configuration
MODEL_PROVIDER=vertex                    # vertex | anthropic
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
MODEL=gemini-2.5-pro                     # gemini-2.5-pro | claude-3-7-sonnet@20250219
ANTHROPIC_API_KEY=

# Centralized Audit Logs & Edge Security
SUMO_ENDPOINT=us2                        # us1 | us2 | eu | etc.
SUMO_ACCESS_ID=your-sumo-access-id
SUMO_ACCESS_KEY=your-sumo-access-key
GCP_PROJECT_ID=your-gcp-project-id
CLOUD_ARMOR_POLICY_NAME=prod-edge-policy

# Primary Identity Provider (IdP) & SaaS
OKTA_DOMAIN=your-company                 # your-company.okta.com
OKTA_API_TOKEN=your-okta-api-token
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@your-company.com
GOOGLE_WORKSPACE_CREDENTIALS_JSON=path/to/credentials.json

# Data Loss Prevention (DLP) & Exfiltration
NIGHTFALL_API_KEY=your-nightfall-api-key

# EDR & Endpoint Telemetry
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
CROWDSTRIKE_CLIENT_ID=your-falcon-client-id
CROWDSTRIKE_CLIENT_SECRET=your-falcon-client-secret
JAMF_SECURITY_API_KEY=your-jamf-security-api-key

# MDM & Device Compliance
JAMF_PRO_URL=https://your-tenant.jamfcloud.com
JAMF_PRO_USERNAME=your-jamf-pro-user
JAMF_PRO_PASSWORD=your-jamf-pro-pass
INTUNE_TENANT_ID=your-azure-tenant-id
INTUNE_CLIENT_ID=your-azure-client-id
INTUNE_CLIENT_SECRET=your-azure-client-secret

# Email Security & Account Takeover (ATO)
ABNORMAL_API_KEY=your-abnormal-api-key

# Threat Intelligence
VIRUSTOTAL_API_KEY=your-virustotal-api-key
OTX_API_KEY=your-alienvault-otx-api-key

# Staging & Alerting
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789
SLACK_TEAM_ID=T0123456789

# Optional: Scanner Data Lake MCP
SCANNER_MCP_URL=https://mcp.your-env.scanner.dev/v1/mcp
SCANNER_MCP_API_KEY=your-scanner-api-key
